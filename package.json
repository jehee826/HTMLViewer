{
  "name": "htmlviewer",
  "version": "0.1.0",
  "description": "완전 로컬 HTML 학습 자료 관리자",
  "author": "jehee826",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "start": "npm run build && electron .",
    "build": "vite build",
    "test": "node --test test/*.test.cjs",
    "test:smoke": "npm run build && node scripts/smoke.cjs",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir --publish never"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1",
    "vite": "8.3.4"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "io.github.jehee826.htmlviewer",
    "productName": "HTMLViewer",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "HTMLViewer"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    }
  }
}
